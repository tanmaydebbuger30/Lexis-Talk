# Copy to api/.env for local development. Never commit the real file.
OPENAI_API_KEY=sk-...

LEXITALK_ENV=development            # production enables HSTS, hides /docs, requires AUDIT_SALT
LEXITALK_ALLOWED_ORIGINS=http://localhost:5173
LEXITALK_TRUST_PROXY_HEADERS=false  # true on Hugging Face Spaces / behind a proxy
LEXITALK_AUDIT_SALT=dev-only-salt   # long random string in production
LEXITALK_RATE_LIMIT_PER_MINUTE=10
LEXITALK_DAILY_REQUEST_BUDGET=500
LEXITALK_TTS_ENABLED=false
